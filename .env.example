# Environment Variables — copy to .env and fill in values

# App password — shared password for all users
APP_PASSWORD=

# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Sheets — one spreadsheet per data type
# Paste each spreadsheet's ID from its URL:
# https://docs.google.com/spreadsheets/d/<ID>/edit

GOOGLE_SHEET_ID_AR_INVOICES=
GOOGLE_SHEET_ID_AR_PAYMENTS=
GOOGLE_SHEET_ID_CANVAS_RUNS=
GOOGLE_SHEET_ID_CANVAS_ITEMS=

# Optional: sheet/tab name within each spreadsheet (default: Sheet1)
# GOOGLE_TAB_AR_INVOICES=Sheet1
# GOOGLE_TAT_AR_PAYMENTS=Sheet1
# GOOGLE_TAB_CANVAS_RUNS=Sheet1
# GOOGLE_TAB_CANVAS_ITEMS=Sheet1
