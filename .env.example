# Environment Variables — copy to .env and fill in values

# App password — shared password for all users
APP_PASSWORD=

# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Sheets — one spreadsheet per data type
# Paste each spreadsheet's ID from its URL:
# https://docs.google.com/spreadsheets/d/<ID>/edit

GOOGLE_SHEET_ID_AR_INVOICES=
GOOGLE_SHEET_ID_AR_PAYMENTS=
GOOGLE_SHEET_ID_CANVAS_RUNS=
GOOGLE_SHEET_ID_CANVAS_ITEMS=

# Customers + Canvas Sales — new spreadsheet with two tabs:
# Tab 1: "Customers"    columns: customer_code, customer_name, address
# Tab 2: "Canvas Sales" columns: canvas_id, item_name, customer_code, customer_name, quantity
GOOGLE_SHEET_ID_CANVAS_CUSTOMERS=

# Optional: sheet/tab name within each spreadsheet (default: Sheet1 or shown below)
# GOOGLE_TAB_AR_INVOICES=Sheet1
# GOOGLE_TAT_AR_PAYMENTS=Sheet1
# GOOGLE_TAB_CANVAS_RUNS=Sheet1
# GOOGLE_TAB_CANVAS_ITEMS=Sheet1
# GOOGLE_TAB_CUSTOMERS=Customers
# GOOGLE_TAB_CANVAS_SALES=Canvas Sales

# Supabase — inventory database
# Get from Supabase project: Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
